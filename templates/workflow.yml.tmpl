name: sdd

on:
  pull_request:
  push:
    branches: ["release/**"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  pre-merge:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # git diff <base>...HEAD braucht die Historie
      - uses: Zheng-Bote/sdd_studio@v0.2.0
        with:
          gate: pre-merge

  pre-release:
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: Zheng-Bote/sdd_studio@v0.2.0
        with:
          gate: pre-release
