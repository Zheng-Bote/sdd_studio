# Schlüssel des KI-Desktops (ADR 0002) — nie einchecken
config/llm.env
**/config/llm.env

# Build-Ausgaben
/bin/

# Oberfläche von sdd-desk (Build-Ausgabe von apps/desk)
/internal/desk/webdist/*
!/internal/desk/webdist/README.md
/apps/desk/node_modules/
/apps/desk/dist/
/apps/desk/.angular/
# Tauri-Hülle: Build-Ausgabe, generierte Schemas, gebaute Sidecars
/apps/desk/src-tauri/target/
/apps/desk/src-tauri/gen/
/apps/desk/src-tauri/binaries/
