# Sprachmodelle für den KI-Desktop sdd-desk (ADR 0002).
# Kopieren nach config/llm.env NEBEN die ausführbare Datei sdd-desk (nicht ins Projekt!) und schützen:
#   chmod 600 config/llm.env
# sdd-desk verweigert eine Datei, die für Gruppe oder andere lesbar ist. Prozessvariablen haben Vorrang.
#
# Je Anbieter:
#   <ANBIETER>_API_KEY   Schlüssel; leer, fehlend oder "none" schaltet den Anbieter ab
#   <ANBIETER>_ENDPOINT  optional; sonst der Standard unten
#   <ANBIETER>_LLM_01..  angebotene Modelle (Modell-IDs beim Anbieter prüfen)
#   <ANBIETER>_TURN_TIMEOUT  optional; Frist eines Gesprächszugs als Dauer (z. B. 45m, 1h30m; 1m bis 4h).
#                            Standard: 30m für lokales Ollama, 10m für Cloud-Anbieter
#
# Inhalte gehen ungeschwärzt an den gewählten Anbieter; vor dem ersten Aufruf fragt sdd-desk nach.
# Mit lokalem Ollama verlassen Inhalte das Gerät nicht.

# --- Ollama lokal (ohne Schlüssel; Modelle werden zusätzlich über /api/tags erkannt) ---
# OLLAMA_LOCAL_ENDPOINT=http://localhost:11434
# OLLAMA_LOCAL_LLM_01=qwen3:14b
# OLLAMA_LOCAL_TURN_TIMEOUT=30m

# --- Ollama Cloud (https://ollama.com) ---
OLLAMA_API_KEY=
# OLLAMA_ENDPOINT=https://ollama.com
OLLAMA_LLM_01=

# --- OpenRouter (OpenAI-kompatibel) ---
OPENROUTER_API_KEY=
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_LLM_01=

# --- NVIDIA NIM (OpenAI-kompatibel) ---
NVIDIA_API_KEY=
# NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_01=

# --- Claude (Anthropic Messages API) ---
CLAUDE_API_KEY=
# CLAUDE_ENDPOINT=https://api.anthropic.com
CLAUDE_LLM_01=

# --- Gemini (OpenAI-kompatibler Endpunkt von Google) ---
GEMINI_API_KEY=
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_LLM_01=
